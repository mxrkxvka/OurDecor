<Window x:Class="OurDecor.AddEditProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить / Редактировать продукт"
        Height="700" Width="800"
        WindowStartupLocation="CenterOwner"
        Icon="Resources/logo.ico"
        FontFamily="{StaticResource MainFont}"
        FontSize="18"
        Background="{StaticResource BackgroundBrush}">

    <!-- ScrollViewer для всей формы -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Border Grid.Row="0" Background="{StaticResource SecondaryBrush}" CornerRadius="6" Margin="0,0,0,20" Padding="15">
                <TextBlock Text="Добавить / Редактировать продукт"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrush}"
                           HorizontalAlignment="Center"/>
            </Border>

            <!-- Форма продукта -->
            <Grid Grid.Row="1" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Артикул:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,8" FontSize="18"/>
                <TextBox x:Name="ArticleTextBox" Grid.Row="0" Grid.Column="1" Height="38" Margin="0,8" Padding="8" FontSize="18"/>

                <TextBlock Text="Тип продукта:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,8" FontSize="18"/>
                <ComboBox x:Name="ProductTypeComboBox" Grid.Row="1" Grid.Column="1"
                          Height="36" Margin="0,8" Padding="6"
                          DisplayMemberPath="Name"
                          SelectedValuePath="ProductTypeID"
                          FontSize="18"/>

                <TextBlock Text="Наименование:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,8" FontSize="18"/>
                <TextBox x:Name="NameTextBox" Grid.Row="2" Grid.Column="1" Height="38" Margin="0,8" Padding="8" FontSize="18"/>

                <TextBlock Text="Мин. стоимость (р):" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,8" FontSize="18"/>
                <TextBox x:Name="MinCostTextBox" Grid.Row="3" Grid.Column="1" Height="38" Margin="0,8" Padding="8" FontSize="18"/>

                <TextBlock Text="Ширина (м):" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,8" FontSize="18"/>
                <TextBox x:Name="WidthTextBox" Grid.Row="4" Grid.Column="1" Height="38" Margin="0,8" Padding="8" FontSize="18"/>
            </Grid>

            <!-- Материалы -->
            <GroupBox Grid.Row="2" Header="Материалы" FontWeight="Bold" FontSize="18" Margin="0,0,0,15">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12" HorizontalAlignment="Stretch">
                        <ComboBox x:Name="MaterialComboBox"
                                  Width="280"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="MaterialID"
                                  Height="36"
                                  Margin="0,0,10,0"
                                  Padding="6"
                                  FontSize="18"/>
                        <TextBox x:Name="MaterialCountTextBox" 
                                 Width="90" 
                                 Margin="0,0,10,0" 
                                 Height="36"
                                 Padding="6"
                                 FontSize="18"
                                 Foreground="Gray" 
                                 Text="Кол-во"
                                 GotFocus="MaterialCountTextBox_GotFocus"
                                 LostFocus="MaterialCountTextBox_LostFocus"/>
                        <Button Content="Добавить" 
                                Click="AddMaterialButton_Click" 
                                Width="100" 
                                Height="36"
                                Style="{StaticResource PrimaryButton}" 
                                FontSize="18"/>
                    </StackPanel>

                    <DataGrid x:Name="MaterialsDataGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              Height="220"
                              RowBackground="White"
                              AlternatingRowBackground="#F5F5F5"
                              GridLinesVisibility="Horizontal"
                              HorizontalAlignment="Stretch"
                              FontSize="16"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Материал" Binding="{Binding MaterialName}" Width="*" MinWidth="150"/>
                            <DataGridTextColumn Header="Количество" Binding="{Binding Count}" Width="100"/>
                            <DataGridTextColumn Header="Цена (р.)" Binding="{Binding Price}" Width="110"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding MaterialType}" Width="140" MinWidth="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>

            <!-- Кнопки действий -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="CancelButton" 
                        Content="Отмена" 
                        Width="110" 
                        Height="40" 
                        Margin="0,0,12,0" 
                        Click="BackButton_Click"
                        FontSize="18"/>
                <Button x:Name="SaveButton" 
                        Content="Сохранить" 
                        Width="150" 
                        Height="40" 
                        Click="SaveButton_Click" 
                        Style="{StaticResource PrimaryButton}"
                        FontSize="18"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>