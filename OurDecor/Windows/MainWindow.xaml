<Window x:Class="OurDecor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Каталог продукции компании"
        Height="750" Width="1200"
        WindowStartupLocation="CenterScreen"
        Icon="Resources/logo.ico"
        FontFamily="{StaticResource MainFont}"
        FontSize="22">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="{StaticResource SecondaryBrush}" Margin="12" Padding="15" CornerRadius="8">
            <DockPanel LastChildFill="True">
                <Image Source="Resources/logo.png"
                       Width="50" Height="50"
                       Margin="0,0,20,0"
                       VerticalAlignment="Center"
                       DockPanel.Dock="Left"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Каталог обоев"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button x:Name="AddButton"
                            Content="Добавить продукт"
                            Style="{StaticResource PrimaryButton}"
                            Click="AddButton_Click"
                            Width="180"
                            Height="40"
                            FontSize="20"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Секция с продуктами -->
        <Grid Grid.Row="1" Margin="15,5,15,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ProductsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Карточка продукта -->
                            <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1"
                                    CornerRadius="8" Margin="0,0,0,15" MouseDown="ProductCard_MouseDown"
                                    Padding="0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F5F5F5"/>
                                                <Setter Property="BorderBrush" Value="#C0C0C0"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Левая часть карточки -->
                                    <StackPanel Grid.Column="0" Margin="20" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <TextBlock Text="{Binding ProductTypeName}" 
                                                       FontSize="24"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryBrush}"/>
                                            <TextBlock Text=" • " FontSize="24" Foreground="#555" Margin="5,0"/>
                                            <TextBlock Text="{Binding Name}" 
                                                       FontSize="24"
                                                       FontWeight="Medium"
                                                       Foreground="Black"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="{Binding Article, StringFormat=Арт: {0}}" 
                                                       FontSize="18" Foreground="#666"
                                                       Margin="0,0,15,0"/>
                                            <TextBlock Text="{Binding Width, StringFormat=Ширина: {0:N2} м}" 
                                                       FontSize="18" Foreground="#666"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding MinCost, StringFormat=Мин. стоимость: {0:N2} р}" 
                                                   FontSize="18" Margin="0,8,0,0" Foreground="#666"/>
                                    </StackPanel>

                                    <!-- Разделитель -->
                                    <Rectangle Grid.Column="1" Width="1" Fill="#EEEEEE" Margin="0,20" Height="Auto"/>

                                    <!-- Правая часть с ценой -->
                                    <Border Grid.Column="2" Background="#FAFAFA" CornerRadius="0,8,8,0">
                                        <StackPanel Margin="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="Стоимость"
                                                       FontSize="20"
                                                       Foreground="#666666"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,0,0,8"/>
                                            <TextBlock Text="{Binding TotalCost, StringFormat={}{0:N2} р}"
                                                       FontSize="26"
                                                       FontWeight="Bold"
                                                       Foreground="Green"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center"/>
                                            <Button Content="Расчет материалов"
                                                    Margin="0,12,0,0"
                                                    Padding="8,4"
                                                    Width="160"
                                                    Height="35"
                                                    FontSize="18"
                                                    Click="CalculateMaterialsButton_Click"
                                                    Style="{StaticResource PrimaryButton}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Статусная строка -->
        <StatusBar Grid.Row="2" Background="{StaticResource SecondaryBrush}" Height="35">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Готово" Margin="12,0" FontSize="18"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding ElementName=ProductsItemsControl, Path=Items.Count, StringFormat=Всего: {0} продуктов}"
                           Margin="12,0" FontSize="18"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>